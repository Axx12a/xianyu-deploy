# ============================================================
# 环境变量模板
#
# 用法：复制成 .env，把「改成你自己的强密码」替换掉，然后
#   docker compose -f docker-compose.deploy.yml up -d
#
# 重要：填好之后的 .env 含有数据库和 Redis 密码，绝对不要提交到仓库。
#      本仓库的 .gitignore 已经把 .env 排除在外。
# ============================================================

# ---------- 数据库 ----------
# 注意：MySQL 的三个密码只在数据库首次初始化时生效。
# 库建好之后再改这里不会改密码，得用 SQL 改。
MYSQL_ROOT_PASSWORD=改成你自己的强密码
MYSQL_DATABASE=xianyu_data
MYSQL_USER=xianyu
MYSQL_PASSWORD=改成你自己的强密码

# ---------- Redis ----------
REDIS_PASSWORD=改成你自己的强密码
REDIS_DB=0

# ---------- 端口 ----------
FRONTEND_PORT=9000
BACKEND_WEB_PORT=8089
WEBSOCKET_PORT=8090
SCHEDULER_PORT=8091

# ---------- 镜像 ----------
IMAGE_REGISTRY=registry.cn-shanghai.aliyuncs.com/zhinian-software
IMAGE_TAG=latest
MYSQL_IMAGE=registry.cn-shanghai.aliyuncs.com/zhinian-software/xianyu-mysql:8.0
REDIS_IMAGE=registry.cn-shanghai.aliyuncs.com/zhinian-software/xianyu-redis:7-alpine

# ---------- 日志与调试 ----------
LOG_LEVEL=INFO
# true 会打印每条 SQL，排查问题用；生产环境保持 false
SQL_ECHO=false

# ---------- Token 缓存 ----------
TOKEN_CACHE_TTL_MIN_HOURS=5
TOKEN_CACHE_TTL_MAX_HOURS=10
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- 定时任务 ----------
REDELIVERY_INTERVAL=5
RATE_INTERVAL=20

# ---------- 验证码 ----------
MAX_CAPTCHA_CONCURRENT=3
CAPTCHA_DRISSIONPAGE_FALLBACK_ENABLED=false
CAPTCHA_DRISSIONPAGE_TIMEOUT=25
CAPTCHA_DRISSIONPAGE_HEADLESS=true

# ---------- 启动行为 ----------
AUTO_START_WEBSOCKET=true
AUTO_START_CRAWL_JOBS=true

# ---------- 外部服务（可选功能，不用可忽略） ----------
# 分销卡券上游服务。只有用到「分销卡券」页面时才会调用。
CARD_DOCK_BASE_URL=http://backend.zhinianboke.com
EXTERNAL_API_KEY=zhinian_bk

# 前端对外访问地址，用于生成分享链接，留空则用默认
FRONTEND_PUBLIC_URL=

# ---------- 远程公告与广告 ----------
# 默认为 true，会定期向 xy.zhinianboke.com 拉取广告和公告。
# 本部署改成 false，减少不必要的外部请求。
REMOTE_OFFICIAL_BASE_URL=https://xy.zhinianboke.com
ENABLE_REMOTE_ADS=false
ENABLE_REMOTE_ANNOUNCEMENTS=false
ENABLE_REMOTE_POPUP_ANNOUNCEMENTS=false
